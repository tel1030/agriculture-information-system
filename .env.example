APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
APP_SESSION_SECURE=false
APP_TRUSTED_PROXY=false
SUPABASE_DB_HOST=your-project-pooler-host
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=your_restricted_app_user
SUPABASE_DB_PASSWORD=replace-with-a-secret
SUPABASE_DB_SSLMODE=verify-full
SUPABASE_DB_SSLROOTCERT=/secure/path/supabase-root.crt
# Set only in the server environment before running php scripts/create_admin.php.
AIS_BOOTSTRAP_ADMIN_EMAIL=
AIS_BOOTSTRAP_ADMIN_PASSWORD=
